# ---------------------------------------------------------------------------
# Backend Next.js — utile uniquement si l'application est réglée sur « Backend ».
# En mode « Clé directe », la clé est saisie dans l'écran Réglages de l'app et
# aucune de ces variables n'est nécessaire.
# ---------------------------------------------------------------------------

# Fournisseur par défaut du backend : openai | anthropic | gemini | mistral
# Si vide, le backend prend le premier fournisseur dont la clé est renseignée.
AI_PROVIDER=openai

# Une clé suffit : renseigne seulement le ou les fournisseurs utilisés.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Modèles — optionnels, chacun a une valeur par défaut dans le code.
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-2.5-pro
MISTRAL_MODEL=pixtral-large-latest
